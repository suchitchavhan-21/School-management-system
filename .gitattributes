# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files with Windows CRLF endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary file declarations (prevent Git from modifying line endings)
*.jar binary
*.png binary
*.PNG binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.sqlite binary
*.sqlite3 binary
*.db binary
